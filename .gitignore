# =========================================================================== #
# 1. Documents: Markdown and PDF
# =========================================================================== #
*.md
*.pdf
# ...except the project README shown on GitHub
!/README.md

# =========================================================================== #
# 2. Code documentation
# =========================================================================== #
/docs/
# mkdocs / sphinx build output
site/
_build/
*.docx
*.pptx

# =========================================================================== #
# 3. Data, models and generated outputs
# =========================================================================== #
# Leading "/" = only the folders at the project root.
# (A plain "data/" would also hide the source package src/data/.)
/data/
/models/
/check_data/
/visualizations/
*.csv
*.tsv
*.xlsx
*.xls
*.feather
*.parquet
*.pkl
*.pickle
*.joblib
*.h5
*.db
*.sqlite

# =========================================================================== #
# 4. Personal / private information
# =========================================================================== #
# Secrets and credentials
.env
.env.*
*.env
secrets/
credentials/
*credentials*.json
*secret*
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc

# Personal notes and local-only files
notes/
personal/
private/
*.local.*
*_local.*
*.private.*

# Local AI assistant settings and memory (may contain personal context)
.claude/
CLAUDE.md
CLAUDE.local.md

# Editor / IDE settings (contain local paths and user preferences)
.vscode/
.idea/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# =========================================================================== #
# 5. Python, Jupyter and tooling
# =========================================================================== #
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Test / tool caches
.pytest_cache/
.cache/
.streamlit/
catboost_info/

# Logs
*.log
*.out
